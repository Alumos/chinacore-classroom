# Host port; the application always listens on port 18080 inside the container.
HOST_PORT=18080
BIND_ADDRESS=0.0.0.0

# /join permits same-origin embedding by default. For a learning sheet hosted
# elsewhere, add its exact origin(s), separated by spaces; do not include paths.
# Learning sheet deployment; replace if using a different domain:
STUDENT_FRAME_ORIGINS="https://learn.alumos.cn"

# compose.yaml uses the published ghcr.io/alumos/chinacore-classroom:latest image.
# For a local source build, use: docker compose -f compose.build.yaml up -d --build
